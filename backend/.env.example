# Copy to backend/.env and fill in real values.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://clauseguard:clauseguard@localhost:5432/clauseguard

# --- LLM ------------------------------------------------------------------
# Required for POST /api/contracts/{id}/analyze. Without a real key the
# endpoint returns 503 and the rest of the app keeps working.
OPENAI_API_KEY=sk-your-openai-api-key-here

# "openai" or "ollama"
DSPY_PROVIDER=openai
DSPY_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# --- Uploads --------------------------------------------------------------
# 10 MB
MAX_UPLOAD_BYTES=10485760

# --- Pipeline behaviour ---------------------------------------------------
# When true, every successful upload immediately runs the DSPy analysis.
# Off by default: it bills the LLM on every upload and blocks the upload
# request until analysis finishes.
AUTO_ANALYZE_ON_UPLOAD=false

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
