# Copy to backend/.env and fill in real values.

# --- Database -------------------------------------------------------------
# postgres:// and postgresql:// (what managed hosts hand out) are accepted
# too and normalised to the asyncpg form at startup.
DATABASE_URL=postgresql+asyncpg://clauseguard:clauseguard@localhost:5432/clauseguard

# --- Layer 1 classifier -----------------------------------------------------
# spaCy pipeline that serves the trained clause classifier. Trained with
# en_core_web_lg, but the artifact never uses word vectors: the ablation
# (models/clause_classifier_v1.spacy_ablation.json) measured a 0.001 macro-F1
# cost for en_core_web_sm at a third of the memory, so small is the default.
# Install with: python -m spacy download <name>
SPACY_MODEL=en_core_web_sm

# --- LLM ------------------------------------------------------------------
# THE ONLY STEP NEEDED FOR REAL AI ANALYSIS: paste a real key here.
# With the placeholder value the app runs in offline demo mode — every
# feature works, and generated text is clearly labeled as canned output.
OPENAI_API_KEY=sk-your-openai-api-key-here

# "auto" (default) | "openai" | "ollama" | "fake"
#   auto   — openai when a real OPENAI_API_KEY is set, otherwise demo mode.
#   fake   — force offline demo mode even when a key exists.
DSPY_PROVIDER=auto
DSPY_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# --- Analysis runs ----------------------------------------------------------
# Clauses analyzed concurrently within one run, and attempts per clause.
ANALYZE_CONCURRENCY=6
ANALYZE_MAX_RETRIES=3

# --- Auth -------------------------------------------------------------------
# Set true when the API is served over HTTPS (adds Secure to the session cookie).
# PRODUCTION: must be true (docs/DEPLOY.md).
SESSION_COOKIE_SECURE=false

# --- Uploads --------------------------------------------------------------
# 10 MB
MAX_UPLOAD_BYTES=10485760

# --- Pipeline behaviour ---------------------------------------------------
# When true, every successful upload immediately schedules an analysis run.
AUTO_ANALYZE_ON_UPLOAD=false

# --- CORS -----------------------------------------------------------------
# Only relevant when the frontend calls the API cross-origin. The default
# setup goes through the Next.js same-origin rewrite and does not need CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
